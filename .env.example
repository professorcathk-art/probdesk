# Supabase (project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for OAuth/magic-link redirects (production: https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AIMLAPI — OpenAI-compatible base URL & key (https://aimlapi.com)
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_API_KEY=your-aiml-api-key

# Optional model overrides (defaults match cost-routing strategy)
AIML_EMBEDDING_MODEL=text-embedding-3-small
AIML_PARSE_MODEL=gpt-4o-mini
AIML_VIBE_MODEL=gpt-4o

# Optional: required for live AI probes via GET /api/health/aiml (see route headers)
HEALTH_CHECK_SECRET=generate-a-long-random-string

# Email (Resend): contact form (/api/contact) + daily digest cron use onboarding@resend.dev as From when RESEND_FROM_EMAIL is unset.
CONTACT_SUPPORT_EMAIL=professor.cat.hk@gmail.com
# Optional verified domain sender; if unset both flows default to onboarding@resend.dev.
# RESEND_FROM_EMAIL=Vennode <notify@vennode.com>
RESEND_API_KEY=re_xxxxx

# Secures GET /api/cron/daily-digest (Vercel Cron sends Authorization: Bearer CRON_SECRET)
CRON_SECRET=generate-a-long-random-string

# Admin (/admin/**) dashboards — server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Comma-separated admin emails (fallback in lib/admin-emails.ts if unset)
VENNODE_ADMIN_EMAIL=REPLACE_ME_ADMIN_EMAIL@yourdomain.com
# Legacy alias (still supported):
# PROBDESK_ADMIN_EMAIL=

# Demo Explore listings: UUID of the admin user who owns seeded showcase intents (see npm run seed:demo-marketplace).
# Required on the server when users submit invites to listings marked is_demo_listing.
MARKETPLACE_DEMO_INBOX_USER_ID=
